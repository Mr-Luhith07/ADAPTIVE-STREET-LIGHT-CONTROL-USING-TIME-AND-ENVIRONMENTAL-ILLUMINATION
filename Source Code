void RTC_SetTime(u32 h, u32 m, u32 s)
{
    HOUR = h;
    MIN = m;
    SEC = s;
}

void RTC_SetDate(u32 d, u32 m, u32 y)
{
    DOM = d;
    MONTH = m;
    YEAR = y;
}

void RTC_SetDay(u32 day)
{
    DOW = day;
}

void RTC_GetTime(u32 *h, u32 *m, u32 *s)
{
    *h = HOUR;
    *m = MIN;
    *s = SEC;
}

void RTC_GetDate(u32 *d, u32 *m, u32 *y)
{
    *d = DOM;
    *m = MONTH;
    *y = YEAR;
}

void RTC_GetDay(u32 *day)
{
    *day = DOW;
}

u8 RTC_IsLeapYear(u32 year)
{
    if((year % 400U) == 0U) return 1U;
    if((year % 100U) == 0U) return 0U;
    if((year % 4U) == 0U) return 1U;
    return 0U;
}

u8 RTC_DaysInMonth(u32 month, u32 year)
{
    switch(month)
    {
        case 1: case 3: case 5: case 7: case 8: case 10: case 12:
            return 31U;
        case 4: case 6: case 9: case 11:
            return 30U;
        case 2:
            return RTC_IsLeapYear(year) ? 29U : 28U;
        default:
            return 0U;
    }
}

